# bootloader hwdef for the hoverboard sideboard (STM32F103C8T6) - CAN bootloader
# see docs/ap-periph-sideboard.md

MCU STM32F103 STM32F103xB

define HAL_BOARD_HOVERBOARD_SB

FLASH_RESERVE_START_KB 0
FLASH_BOOTLOADER_LOAD_KB 23

# reserve some space for params
APP_START_OFFSET_KB 2

# board id (must match hwdef.dat)
APJ_BOARD_ID AP_HW_F103_PERIPH

env AP_PERIPH 1

# crystal-less board, clock comes from the patch
OSCILLATOR_HZ 8000000
define CH_CFG_ST_FREQUENCY 1000

FLASH_SIZE_KB 128

# debug LED: LED1 (red) - the only one that is always safe to use
PA0 LED_BOOTLOADER OUTPUT LOW
define HAL_LED_ON 1

# --- CAN --------------------------------------------------------------------
PA11 CAN_RX CAN
PA12 CAN_TX CAN
# Option 2 (LED-board connector + remap) - see hwdef.dat and the patch:
# PB8 CAN_RX CAN
# PB9 CAN_TX CAN

# UART for debug/programming (4-pin cable, USART2)
PA2 USART2_TX USART2 SPEED_HIGH NODMA
PA3 USART2_RX USART2 SPEED_HIGH NODMA

define HAL_USE_SERIAL FALSE
define HAL_USE_EMPTY_IO TRUE
define PORT_INT_REQUIRED_STACK 64
define DMA_RESERVE_SIZE 0
define __FPU_PRESENT 0
define CH_CFG_ST_TIMEDELTA 0
define SERIAL_BUFFERS_SIZE 512
define HAL_UART_NODMA
define HAL_CAN_POOL_SIZE 2500
define HAL_CAN_RX_QUEUE_SIZE 32

MAIN_STACK 0x800
PROCESS_STACK 0x800

define HAL_USE_ADC FALSE
define STM32_ADC_USE_ADC1 FALSE
define HAL_DISABLE_ADC_DRIVER TRUE

# use a small bootloader timeout
define HAL_BOOTLOADER_TIMEOUT 1000
